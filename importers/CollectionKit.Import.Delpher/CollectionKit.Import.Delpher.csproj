<Project Sdk="Microsoft.NET.Sdk">

  <!-- REAL Delpher enrichment via the KB's public SRU endpoint (jsru.kb.nl, no API key):
       for every album in a source set, searches historical newspaper articles around the
       release year and writes news-delpher.json (headline, date, paper, deep-link) which the
       MusicNews importer merges as real news items.

       Rights: only metadata (headline/date/publisher) and a Delpher DEEP-LINK are stored —
       no OCR article text. Snippets from post-1945 papers are a curation step under
       citaatrecht, per the project proposal. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- the hi-res page masked to the article's own zones (Pages.cs) -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
